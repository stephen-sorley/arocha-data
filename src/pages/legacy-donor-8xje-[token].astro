---
import { actions } from "astro:actions";
import { actionName } from "../actions/cancel.ts";

import {
  getSubInfo,
  getStatuses
} from "../manager.ts";

import Layout from "../layout.astro";
import Card from "../card.astro";
import Modal from "../modal.astro";

// These three icons are all from Tabler (https://tabler.io/icons).
import IconActive   from "../circle-check.svg";
import IconInactive from "../circle-x.svg";
import IconUnknown  from "../help.svg";

export const prerender = false;

/* DEBUG_161: Strict CSP not currently working, add this workaround until it does: */
Astro.csp?.insertScriptResource("'unsafe-inline'");
Astro.csp?.insertStyleResource("'unsafe-inline'");
Astro.csp?.insertScriptResource("'self'");
Astro.csp?.insertStyleResource("'self'");

const {subInfo} = getSubInfo(Astro.params.token);
if (!subInfo) {
  return new Response("Account not found", { status: 404 });
}


const result = Astro.getActionResult(actions[actionName]);
if (result && result.error) {
  console.error(`[${result.code}] ${result.error}`);
}


const toFancyDate = (dateStr: string) => {
  const [year, month, day] = dateStr.split("-");
  const date = new Date(Number(year), Number(month) - 1, Number(day));

  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric"
  });
};

const start = performance.now();
const statuses = await getStatuses(subInfo);
const finish = performance.now();
console.log(`Retrieved statuses in ${Math.round(finish-start)/1000}s`);

const getIcon = (status: (typeof statuses)[0]) => {
  if (status === "active") {
    return IconActive;
  } else if (status === "inactive") {
    return IconInactive;
  }
  return IconUnknown;
}

const getCnpId = (id: string) => {
  const extracted = id.split("https://connect.clickandpledge.com/?ru=")?.[1]?.slice(0, 10);
  return extracted? extracted : id;
}

---

<Layout title="Legacy Donation Manager">
  <div class="container">
    <div class="heading">
      {subInfo.greeting && (<div class="greeting">Hi {subInfo.greeting}!</div>)}
      <div class="description">Here are your household's recurring donations.</div>
      {result?.error && (
        <div tabindex="-1" autofocus class="error">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 9v4" />
            <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0" />
            <path d="M12 16h.01" />
          </svg>
          Failed to stop donation (server error).
        </div>
      )}
      {result?.data && (
        <div tabindex="-1" autofocus class="success">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
            <path d="M9 12l2 2l4 -4" />
          </svg>
          Donation {result.data} has been stopped.
        </div>
      )}
    </div>
    {subInfo.subs.map((sub, i) => (
    <Card class="sub" level="h2" align="start"
      title={`$${sub.amount} / ${sub.frequency}`}
      data-status={statuses[i]}
      icon={getIcon(statuses[i])}
      iconAlt={statuses[i] === "inactive"? "stopped" : statuses[i]}
    >
      <div class="details">
        <div>For: {sub.designation}</div>
        <div>Since: {toFancyDate(sub.since)}</div>
        <div>ID: <span>{sub.processor === "cnp"? getCnpId(sub.processorId) : sub.processorId}</span></div>
      </div>
      { sub.processor === "cnp" && (
      <a class="primary" href={sub.processorDonorUrl} target="_blank">
        Manage at Click and Pledge
      </a>
      )}
      { sub.processor !== "cnp" && statuses[i] !== "inactive" && (
      <Fragment>
        <button class="default" type="button" commandfor={`confirm-${i}`} command="show-modal">
          Stop Recurring Gift
        </button>

        <Modal id={`confirm-${i}`}>
          <form class="confirm" method="post" action={actions[actionName]}>
            <h2>Are you sure?</h2>

            <input type="hidden" name="index" value={i} />

            <input type="hidden" name="proc" value={sub.processor} />

            <input type="hidden" name="procid" value={sub.processorId} />

            <div>
              <div>{`$${sub.amount} / ${sub.frequency}`}</div>
              <div>{`For: ${sub.designation}`}</div>
              <div>{`Since: ${toFancyDate(sub.since)}`}</div>
            </div>

            <button class="primary outline" type="submit">
              Stop Recurring Gift
            </button>
            <button class="default" type="button" commandfor={`confirm-${i}`} command="close">
              Keep Giving
            </button>
          </form>
        </Modal>
      </Fragment>
      )}
      { statuses[i] === "inactive" && (
      <div class="inactive">
        Already Stopped
      </div>
      )}
    </Card>
    ))}
  </div>
</Layout>

<script>
{
  /*
    Clean up action-related query params after page loads.

    This is a progressive enhancement - it removes the possibility of double-submitting
    stop requests on refresh or history navigation, but if javascript is disabled
    this will still work fine.
  */
  const url = new URL(window.location.href);
  url.searchParams.delete("_action");
  window.history.replaceState({ path: url.href }, '', url.href);
}
</script>

<style>
div.heading {
  margin-block-end: calc(-1 * var(--sp-sm));
  flex-basis: 100%;
  .greeting {
    text-align: center;
    font-size: var(--text-2xl);
    font-weight: 300;
    margin-block-end: var(--sp-2xs);
  }
  .description {
    text-align: center;
    font-size: var(--text-lg);
    font-weight: 400;
  }
}

div.error { --color: var(--color-error); }
div.success { --color: var(--color-success); }
div:is(.error,.success) {
  display: flex;
  align-items: center;
  margin-block-start: var(--sp-sm);
  margin-inline: auto;
  font-family: var(--font-form);
  font-size: var(--text-base);
  font-weight: 300;
  width: fit-content;
  &:focus-visible {
    outline: none;
  }
  border: 4px solid var(--color);
  border-block-width: 1px;
  padding-inline: var(--sp-sm);
  padding-block: 0.25lh;
  svg {
    align-self: flex-start;
    display: inline;
    width: 1.5lh;
    height: 1.5lh;
    padding-inline-end: 1ch;
    color: var(--color);
  }
}

.container {
  align-self: start;
  justify-self: center;
  width: 100%;
  
  display: flex;
  flex-wrap: wrap;
  flex-wrap: balance; /* only supported in Chrome so far, will fall back to wrap if unsupported */
  gap: var(--sp-xl);
  justify-content: center;
}

:global(.sub) {
  font-family: var(--font-main);
  flex: 0 1 28ch;

  &[data-status="unknown"] > :global(.card-header) {
    --tint: var(--color-warning);
    --tint-ratio: 10%;
  }
  &[data-status="active"] > :global(.card-header) {
    --tint: var(--color-success);
    --tint-ratio: 8%;
  }
  &[data-status="inactive"] > :global(.card-header) {
    --tint: var(--color-error);
    --tint-ratio: 7%;
  }

  &> :global(.card-body) {
    padding-block-start: var(--sp-xs);
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr min-content;
    gap: var(--sp-md);
  }
}

div.details {
  display: flex;
  font-size: calc(var(--text-base) * 0.9);
  flex-direction: column;
  align-items: start;
  width: 100%;
  gap: var(--sp-xs);

  div {
    flex: 0 1 auto;
  }
}
div.inactive {
  text-align: center;
  padding-inline: 1lh;
  padding-block: 0.25lh;
  border: 0.125em solid var(--color-border);
}

form.confirm {
  font-size: var(--text-lg);
  padding: var(--sp-md);
  padding-top: var(--sp-sm);
  min-width: 40ch;
  min-height: 6lh;
  
  display: grid;
  grid-template-columns: 1fr;
  grid-template-rows: repeat(3, fit-content);
  gap: var(--sp-sm);

  h2 {
    font-size: var(--text-2xl);
    weight: 400;
    margin-inline: calc(-1 * var(--sp-xs));
  }

  & > div {
    justify-self: center;
    font-weight: 300;
    margin-block-end: var(--sp-sm);
    font-family: var(--font-main);
  }
  
  button {
    width: 100%;
    white-space: nowrap;
  }
}
</style>