---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { Polymorphic } from "astro/types";
import { clean } from "./cleanprops.ts";

export type Props<Tag extends "section" | "form"> = Polymorphic<{ as: Tag }> & {
  title?: string,

  level?: "h2" | "h3" | "h4" | "h5" | "h6",

  align?: "start" | "center" | "end",

  icon?: AstroComponentFactory,

  iconAlt?: string,
}

const {
  as: Tag = "section",
  title,
  level = "h2",
  align = "start",
  icon: Icon,
  iconAlt,
  class: className,
  ...rest
} = Astro.props;

const H = level;
---
<Tag class:list={[className]} {...clean(rest)}>
  <H class:list={["card-header", align]}>
    { Icon && align !== "start" && (
    <Fragment>
      <Icon aria-hidden="true" />
      { iconAlt && (<span class="sr-only">{iconAlt}</span>)}
    </Fragment>
    )}
    <span>{title}</span>
    { Icon && align !== "end" && (
    <Fragment>
      <Icon aria-hidden="true" />
      { iconAlt && (<span class="sr-only">{iconAlt}</span>)}
    </Fragment>
    )}
  </H>
  <div class="card-body">
    <slot />
  </div>
</Tag>


<style>
@layer components {
  :is(section, form) {
    border-radius: var(--radius-md);
    box-shadow:
      0 2px 2px 0    rgb(0 0 0 / 0.14),
      0 3px 1px -2px rgb(0 0 0 / 0.2),
      0 1px 5px 0    rgb(0 0 0 / 0.12);
    overflow: clip;

    display: grid;
    grid-template-rows: min-content auto;
    grid-template-columns: 1fr;
  }

  .card-header {
    &.center span { text-align: center; }
    &.start span {  text-align: start; }
    &.end span {    text-align: end; }
    padding-inline: var(--sp-sm);
    padding-block: 0.5lh;

    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-xs);

    --fg: var(--color-fg);
    --bg: var(--color-bg);
    --tint: var(--fg);
    --tint-ratio: 3%;
    --tint-ratio-icon: calc(var(--tint-ratio)*5);
    color: var(--fg);
    background-color: color-mix(in oklch, var(--bg), var(--tint) var(--tint-ratio));
    border-block-end: 1px solid color-mix(in oklch, var(--bg), var(--tint) calc(var(--tint-ratio) * 2));

    font-weight: 400;
    font-size: var(--text-xl);

    /* Caller may have passed in an optional header icon. */
    :global(svg) {
      flex-shrink: 0;
      width: 1lh;
      height: 1lh;
      color: color-mix(in oklch, var(--bg), var(--tint) var(--tint-ratio-icon));
    }
  }

  .card-body {
    padding: var(--sp-sm);
    width: 100%;
  }
}
</style>