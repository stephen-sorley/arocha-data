---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";

import logo from "./logo.png";
import "./styles/globals.css";

export interface Props extends HTMLAttributes<"main"> {
  title: string,
}

const {
  title,
  ...rest
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/favicon.ico">
    <link rel="preload" as="font" type="font/woff2" href="/EzzoBook.woff2" crossorigin="anonymous" />
  </head>
  <body>
    <header>
      <div class="cap"></div>
      <div class="heading">
        <nav>
          <a href="https://arocha.us">
            <Image src={logo} alt="" aria-hidden="true" priority={true} width={2026} height={530} />
            <span class="sr-only">Home - A Rocha USA</span>
          </a>
        </nav>
        <h1>{title}</h1>
      </div>
    </header>
    <main {...rest}>
      <slot />
    </main>
    <footer class="cap">
      <div>&copy; {currentYear} A ROCHA USA</div>
    </footer>
  </body>
</html>

<style> @layer components {
body {
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-x: clip;

  .cap {
    font-size: var(--text-base);
    min-height: 2lh;
    width: 100%;
  }

  header {
    background-color: var(--color-bg);
    box-shadow: 0 0.5rem 0.375rem 0 rgba(0, 0, 0, 0.3);

    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto;
    width: 100%;

    div.cap {
      background-color: var(--color-main);
    }

    div.heading {
      max-width: var(--content-width);
      justify-self: center;
      width: 100%;

      color: var(--color-alt3);
      padding-inline: var(--sp-sm);
      padding-block: var(--sp-md);

      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-sm);
      font-size: var(--text-xl);
     
      nav {
        overflow: visible;
      }
      
      h1 {
        align-content: center;
        width: max-content;
        font-weight: bolder;
      }

      img {
        max-height: 2lh;
        max-width: 100%;
        height: auto;
        width: auto;
      }
    }
  }

  main {
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: auto;
    align-self: center;
    margin-block: 0.875rem;
    width: 100%;
    max-width: var(--content-width);

    display: flex;
    flex-direction: column;

    padding: var(--sp-md);
  }

  footer {
    background-color: var(--color-alt3);
    color: var(--color-bg);

    div {
      padding-block: var(--sp-sm);
      margin-inline: auto;
      font-weight: bold;
      display: grid;
      place-items: center;
    }
  }
}
} </style>