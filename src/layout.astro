---
import type { HTMLAttributes } from "astro/types";
import { clean } from "./cleanprops.ts";

import logo from "./logo.png";
import "./styles/globals.css";

export interface Props extends HTMLAttributes<"main"> {
  title: string,
  nolink?: boolean
}

const {
  title,
  nolink = true,
  ...rest
} = Astro.props;

const rootPage = "/legacy-donation-manager";

const currentYear = new Date().getFullYear();
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8"/>
    <title>{title + " - A Rocha USA"}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/favicon.ico">
    <link rel="preload" as="font" type="font/woff2" href="/EzzoBook.woff2" crossorigin="anonymous" />
    <link rel="preload" as="image" href={logo.src} type="image/png" />
    <style is:inline>
      @layer reset, base, components, utilities;
    </style>
  </head>
  <body>
    <header>
      <div></div>

      <div>
        <nav>
          <a href="https://arocha.us">
            <img 
              src={logo.src} 
              width={logo.width} 
              height={logo.height} 
              aria-hidden="true"
              alt=""
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
            <span class="sr-only">Home - A Rocha USA</span>
          </a>
        </nav>
        <h1>
          {(Astro.url.pathname===rootPage || nolink)? (
          <span>{title}</span>
          ) : (
          <a href={rootPage}>
            <span>{title}</span>
          </a>
          )}
        </h1>
      </div>
    </header>

    <main {...clean(rest)}>
      <slot />
    </main>

    <footer>
      <div>&copy; {currentYear} A ROCHA USA</div>
    </footer>
  </body>
</html>

<style>
@layer components {

body {
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-x: clip;
}

header {
  background-color: var(--color-bg);
  box-shadow: 0 0.5rem 0.375rem 0 rgba(0, 0, 0, 0.3);

  display: grid;
  grid-template-columns: 1fr;
  grid-template-rows: auto auto;
  width: 100%;

  div:nth-of-type(1) {
    background-color: var(--color-main);
    min-height: 2lh;
    width: 100%;
  }

  div:nth-of-type(2) {
    max-width: var(--content-width);
    justify-self: center;
    width: 100%;

    color: var(--color-alt3);
    padding-inline: var(--sp-sm);
    padding-block: var(--sp-md);

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-sm);
    font-size: var(--text-xl);
  }
    
  nav {
    overflow: visible;
  }

  img {
    height: 2lh;
    width: auto;
    max-width: 100%;
  }
    
  h1 {
    align-content: center;
    width: max-content;
    font-weight: bolder;

    &> span, a {
      padding-inline: 1ch;
      padding-block-start: 0.25lh;
      padding-block-end: 0.55lh;
    }
    a {
      text-decoration: underline;
      text-decoration-thickness: from-font;
      text-decoration-color: transparent;
      text-underline-offset: 0.1lh;
      transition:
        background-color var(--duration) ease,
        text-decoration-color var(--duration) ease;
      &:hover {
        background-color: color-mix(in oklch, var(--color-bg), var(--color-fg) 2.5%);
        text-decoration-color: currentColor;
      }
    }
  }
}

main {
  flex-grow: 1;
  flex-shrink: 0;
  flex-basis: auto;
  align-self: center;
  margin-block: 0.875rem;
  width: 100%;
  max-width: var(--content-width);

  display: flex;
  flex-direction: column;

  padding: var(--sp-md);
}

footer {
  min-height: 2lh;
  width: 100%;
  background-color: var(--color-alt3);
  color: var(--color-bg);

  div {
    padding-block: var(--sp-sm);
    margin-inline: auto;
    font-weight: bold;
    display: grid;
    place-items: center;
  }
}

}
</style>