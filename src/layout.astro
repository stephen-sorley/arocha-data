---
import type { HTMLAttributes } from "astro/types";
import { clean } from "./cleanprops.ts";

import fontUrl from './styles/DMSans.woff2?url';

import logo from "./logo.png";
import "./styles/globals.css";

export interface Props extends HTMLAttributes<"main"> {
  title: string,
  nolink?: boolean
}

const {
  title,
  nolink = false,
  ...rest
} = Astro.props;

const rootPage = "/legacy-donation-manager";

const currentYear = new Date().getFullYear();
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8"/>
    <title>{title + " - A Rocha USA"}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/favicon.ico">
    <link rel="preload" as="font" type="font/woff2" href={fontUrl} crossorigin="anonymous" />
    <link rel="preload" as="image" href={logo.src} type="image/png" fetchpriority="high" />
    <style is:inline>
      @layer reset, base, components, utilities;
    </style>
  </head>
  <body>
    <header>
      <div></div>

      <div>
        <nav>
          <a href="https://arocha.us">
            <img 
              src={logo.src} 
              width={logo.width} 
              height={logo.height} 
              aria-hidden="true"
              alt=""
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
            <span class="sr-only">Home - A Rocha USA</span>
          </a>
        </nav>
        <h1>
          {(Astro.url.pathname===rootPage || nolink)? (
          <span>{title}</span>
          ) : (
          <a href={rootPage}>
            <span>{title}</span>
          </a>
          )}
        </h1>
      </div>
    </header>

    
    <div class="lmargin"></div>

    <main {...clean(rest)}>
      <slot />
    </main>

    <div class="rmargin"></div>

    
    <footer>
      <div>&copy; {currentYear} A ROCHA USA</div>
    </footer>
  </body>
</html>

<style>
@layer components {

html, body {
  background-color: var(--color-alt3);
}

body {
  min-height: 100dvh;
  place-items: center;
  overflow-x: clip;
  overscroll-behavior: none;

  display: grid;
  grid-template-rows: auto 1fr auto;
  grid-template-columns: 1fr minmax(0, var(--content-width)) 1fr;
  grid-template-areas: 
    "header header header"
    "lmargin main rmargin"
    "footer footer footer";
}
header   { grid-area: header; }
.lmargin { grid-area: lmargin; width: 100%; height: 100%; }
main     { grid-area: main; }
.rmargin { grid-area: rmargin; width: 100%; height: 100%; }
footer   { grid-area: footer; }

body > * > * {
  grid-column: 2;
}

/* background for main page contents and left/right margins. */
body > div, main {
  background-color: var(--color-bg);
}

header {
  background-color: var(--color-bg);
  box-shadow: 0 0.5rem 0.375rem 0 rgba(0, 0, 0, 0.3);
  z-index: 1;

  display: grid;
  grid-template-rows: auto auto;
  grid-template-columns: subgrid;
  place-items: center;
  width: 100%;

  div:nth-of-type(1) {
    grid-column: 1 / -1;

    background-color: var(--color-main);
    height: 2lh;
    width: 100%;
  }

  div:nth-of-type(2) {
    width: 100%;

    color: var(--color-alt3);
    padding-inline: var(--sp-sm);
    padding-block: var(--sp-md);

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-sm);
    font-size: var(--text-2xl);
  }

  a {
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-decoration-color: transparent;
    text-underline-offset: 0.1lh;
    transition:
      background-color var(--duration) ease,
      text-decoration-color var(--duration) ease;
    &:hover {
      background-color: color-mix(in oklch, var(--color-bg), var(--color-fg) 2.5%);
      text-decoration-color: currentColor;
    }
  }
 
  nav {
    overflow: visible;
  }

  img {
    height: 1.5lh;
    width: auto;
    max-width: 100%;
    pointer-events: none;
  }

  h1 {
    align-content: center;
    width: max-content;
    font-weight: 300;
    font-size: 0.9em;

    &> span, a {
      padding-block: 0.4lh;
    }
  }
}

main {
  height: 100%;
  width: 100%;

  display: grid;
  grid-template: 1fr / 1fr;
  
  background-color: var(--color-bg);

  padding: var(--sp-md);
}

footer {
  display: grid;
  grid-template-columns: subgrid;
  place-items: center;

  min-height: 2lh;
  width: 100%;
  background-color: var(--color-alt3);
  color: var(--color-bg);

  div {
    padding-block: var(--sp-sm);
    margin-inline: auto;
    font-weight: bold;
    display: grid;
    place-items: center;
  }
}

}
</style>