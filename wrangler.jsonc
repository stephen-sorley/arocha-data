{
	"$schema": "node_modules/wrangler/config-schema.json",
  "name": "arocha-legacy-subs",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-08-19",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
    // Prevent random requests from running workers.
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/_actions/login-8sdf4wdadf", // execute workers for Astro Actions endpoints
      "/legacy-donor-8xje-*" // execute workers for rendering donor portal pages
    ]
	},
	"observability": {
		"enabled": true
	},
  "route": {
    "pattern": "donors.arocha.us",
    "custom_domain": true,
    "zone_name": "arocha.us"
  },
}